# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local capture/export data (screenshots, exported PNGs, metadata)
/data/

# internal-only dev docs and reference material — build log, the AI dev
# guide, the original planning doc (has some stray voice-dictation noise),
# third-party mockup/reference images with unclear redistribution rights,
# and the raw device-frame source files (the copies the app actually uses
# live in /public/frames/). None of this is meant for a public repo.
/docs/

# AGENTS.md is regenerated automatically by `next dev`/`next build` itself
# (Next.js-version-specific coding notes) — local dev tooling, not part of
# the shipped project. CLAUDE.md is tracked on purpose: it's this project's
# own developer guide for anyone (human or AI) extending the codebase.
AGENTS.md

# Playwright MCP tool output (screenshots taken while testing with an AI
# coding assistant) — local scratch, not project source
/.playwright-mcp/
